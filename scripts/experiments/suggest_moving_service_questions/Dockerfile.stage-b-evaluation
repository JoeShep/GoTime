FROM python:3.12-slim

WORKDIR /workspace

COPY backend/requirements.txt /tmp/gotime/requirements.txt
COPY backend/requirements-dev.txt /tmp/gotime/requirements-dev.txt
COPY scripts/experiments/suggest_moving_service_questions/requirements-openai.lock /tmp/gotime/requirements-openai.lock

RUN python -m pip install --no-cache-dir \
    -r /tmp/gotime/requirements-dev.txt \
    -r /tmp/gotime/requirements-openai.lock

CMD ["python", "scripts/experiments/suggest_moving_service_questions/run_openai_stage_b_pilot.py"]
